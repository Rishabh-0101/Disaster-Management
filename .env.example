# ============================================================
# 1) Supabase (optional — only if you use Supabase instead of the
#    Node/Python backend in server/ or python-backend/)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2) Your own backend API (server/ Node.js OR python-backend/ FastAPI)
#    Run one of those two, then point this at it:
VITE_API_BASE_URL=http://localhost:5000/api

# 3) Firebase — needed for "Continue with Google" / "Continue with GitHub"
#    Get these from https://console.firebase.google.com
#    (Project Settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 4) Google Maps — only needed if you swap MapView.tsx for GoogleMapView.tsx
#    Get this from https://console.cloud.google.com (Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=
