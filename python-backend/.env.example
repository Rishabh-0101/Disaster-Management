# ================================
# Choose ONE database and fill in its connection details:

# Option A — MongoDB (via motor)
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=samadhansetu

# Option B — PostgreSQL (via SQLAlchemy)
DATABASE_URL=postgresql://user:password@localhost:5432/samadhansetu

# JWT secret for signing login tokens
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173
