# ================================
# 1) MongoDB — paste your connection string here
#    Get it free from https://www.mongodb.com/cloud/atlas
#    Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/samadhansetu
MONGODB_URI=your_mongodb_connection_string_here

# 2) JWT secret — any long random string (for signing login tokens)
JWT_SECRET=change_this_to_a_long_random_secret

# 3) Server port
PORT=5000

# 4) Allowed frontend origin (your React app's URL)
CLIENT_ORIGIN=http://localhost:5173
